# ============================================
# Stella Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret for authenticating Vercel cron job requests
CRON_SECRET="your-cron-secret-here"

# API key for client authentication
API_KEY="your-api-key-here"

# Firebase Admin SDK service account JSON (for push notifications)
# Paste the full JSON string from your Firebase Console
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
